{
	"name": "ticket-in",
	"version": "1.0.0",
	"private": true,
	"license": "UNLICENSED",
	"workspaces": [
		"backend",
		"frontend",
		"infra",
		"microservices/*"
	],
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"esbuild@0.28.2": true,
		"lmdb@3.5.6": true,
		"msgpackr-extract@3.0.4": true,
		"unrs-resolver@1.12.2": true
	},
	"scripts": {
		"start:dev": "concurrently -c blue,green \"npm run start:dev:*\"",
		"start:dev:backend": "npm run start:dev --workspace=backend",
		"start:dev:frontend": "npm run start --workspace=frontend"
	},
	"devDependencies": {
		"concurrently": "^10.0.5"
	}
}
